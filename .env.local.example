# Copy to .env.local and fill in. .env.local is gitignored — never commit real values.
# Values come from: Supabase dashboard > Project Settings > API keys.

# Public — safe to expose to the browser. Every table these can reach is
# protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only — BYPASSES Row Level Security. Never prefix with NEXT_PUBLIC_,
# never import into a Client Component. Leaking this is a full database
# compromise.
SUPABASE_SECRET_KEY=sb_secret_...

# Server-only — used by scripts that talk to the Supabase Management API
# (migrations, seeding). Not required by the running app.
SUPABASE_ACCESS_TOKEN=sbp_...
SUPABASE_PROJECT_REF=<project-ref>

# Google Analytics 4 measurement ID. Runs alongside the first-party
# analytics tables, which remain the source of truth. Loaded only after the
# reader grants tracking consent.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# IndexNow ownership key. The matching <key>.txt must exist in public/.
INDEXNOW_KEY=

# Cloudinary — image and video hosting. The secret is server-only and is used to
# sign uploads; it must never be exposed to the browser.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Protects the scheduled ingestion endpoint. Vercel Cron sends this as a bearer
# token automatically once it is set as a project environment variable.
CRON_SECRET=

# AI key pools. Comma-separated; any one key enables every AI feature. Jobs
# walk the chain in quality order — every Gemini key, then Groq, then
# OpenRouter's free models — and a key that is refused cools down while the
# rest carry on. Gemini, Groq and OpenRouter all have free tiers that need no
# payment card. The Vercel AI Gateway refuses requests until a card is on
# file for the team, so a gateway key alone is not enough.
GOOGLE_GENERATIVE_AI_API_KEYS=
GROQ_API_KEYS=
OPENROUTER_API_KEYS=
ANTHROPIC_API_KEY=
AI_GATEWAY_API_KEY=
# The single-key names still work and are added to the pool.
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=

# Optional model overrides, if a default model id is ever retired.
AI_DRAFTING_MODEL=
AI_ASSIST_MODEL=
GROQ_DRAFTING_MODEL=
GROQ_ASSIST_MODEL=
# Comma-separated OpenRouter ids to try before the built-in free defaults.
OPENROUTER_DRAFTING_MODELS=
OPENROUTER_ASSIST_MODELS=

# Event engine streams that need their own credentials. Each stream joins the
# fifteen-minute pulse the moment its key is present; nothing else changes.
#
# YouTube needs a Google Cloud API key with the YouTube Data API v3 enabled —
# the AI Studio key used for Gemini does not carry YouTube access.
YOUTUBE_API_KEY=
# Reddit needs a "script" app from reddit.com/prefs/apps; the id is the short
# string under the app name, the secret is labelled as such.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# The one address the paper is published at, with no trailing slash. Every
# canonical link, sitemap entry, feed item and structured-data URL is built
# from it, so it must be the production domain in production.
NEXT_PUBLIC_SITE_URL=https://www.example.com
# Set to 1 once the domain resolves to this project: page requests on every
# other host (the vercel.app one included) then get a permanent redirect to
# the same path on NEXT_PUBLIC_SITE_URL. API routes are left where they are.
CANONICAL_REDIRECT=

# Search engine ownership tokens, from each tool's "HTML tag" verification
# method: only the content value, not the whole tag. Empty ones are left out.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
YANDEX_SITE_VERIFICATION=

# Sign in with Google: a "Web application" OAuth client from Google Cloud
# (Google Auth Platform > Clients). Its authorized redirect URI must be
# <NEXT_PUBLIC_SITE_URL>/auth/google/callback, so Google names this site, not
# Supabase's, on its account chooser. The secret is server-only. The same
# client ID must be listed on Supabase's Google provider, which verifies the
# identity token the site hands it.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
