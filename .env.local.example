# Copy to .env.local and fill in. .env.local is gitignored — never commit real values.
# Values come from: Supabase dashboard > Project Settings > API keys.

# Public — safe to expose to the browser. Every table these can reach is
# protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only — BYPASSES Row Level Security. Never prefix with NEXT_PUBLIC_,
# never import into a Client Component. Leaking this is a full database
# compromise.
SUPABASE_SECRET_KEY=sb_secret_...

# Server-only — used by scripts that talk to the Supabase Management API
# (migrations, seeding). Not required by the running app.
SUPABASE_ACCESS_TOKEN=sbp_...
SUPABASE_PROJECT_REF=<project-ref>

# Google Analytics 4 measurement ID. Runs alongside the first-party
# analytics tables, which remain the source of truth. Loaded only after the
# reader grants tracking consent.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# IndexNow ownership key. The matching <key>.txt must exist in public/.
INDEXNOW_KEY=

# Cloudinary — image and video hosting. The secret is server-only and is used to
# sign uploads; it must never be exposed to the browser.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Protects the scheduled ingestion endpoint. Vercel Cron sends this as a bearer
# token automatically once it is set as a project environment variable.
CRON_SECRET=

# AI provider. Any ONE of these enables every AI feature. Precedence is the
# order below, so setting a Gemini key overrides the rest.
#
# Gemini and Groq both have free tiers that need no payment card. The Vercel AI
# Gateway will not serve requests until a card is on file for the team, even to
# spend its own free credits — so a valid gateway key alone is not enough.
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
AI_GATEWAY_API_KEY=

# Optional model overrides, if a default model id is ever retired.
AI_DRAFTING_MODEL=
AI_ASSIST_MODEL=
